# FIXED VERSION — Gemini Recommended Fixes
# Based on: Gemini 3.1 Pro audit (04/22/2026)
#
# Vulnerabilities Addressed:
#   V1 - SQL Injection         → parameterized queries
#   V2 - Hardcoded Secret      → os.environ.get() with startup ValueError
#   V3 - Plaintext Passwords   → passlib CryptContext with bcrypt
#   V4 - JWT alg:none          → hardcoded algorithms=["HS256"] with try/except
#   V5 - Username Enumeration  → unified error message (in auth.py)
#
# Additional fix from Gemini's extra finding:
#   + JWT issued as HttpOnly cookie instead of JSON body (in auth.py)
#     to prevent XSS-based token theft from sessionStorage
#
# Note on V2 OWASP classification:
#   Gemini classified SECRET_KEY = "secret" under A02:2025 (Security Misconfiguration).
#   Ground truth is A04:2025 (Cryptographic Failures). The fix applied is identical
#   regardless of classification — the OWASP category difference does not affect
#   the correctness of the remediation.
# ============================================================

import jwt
import sqlite3
import os
from datetime import datetime, timedelta, timezone
from fastapi import HTTPException
from passlib.context import CryptContext

# ── Password hashing context ─────────────────────────────────
# V3 FIX (Gemini): passlib CryptContext with bcrypt
pwd_context = CryptContext(schemes=["bcrypt"], deprecated="auto")

# ── JWT secret loaded from environment ───────────────────────
# V2 FIX (Gemini): Read from environment variable; raise ValueError if not set
SECRET_KEY = os.environ.get("JWT_SECRET_KEY")
if not SECRET_KEY:
    raise ValueError("JWT_SECRET_KEY environment variable is not set")

ALGORITHM = "HS256"
ACCESS_TOKEN_EXPIRE_MINUTES = 30

DB_PATH = os.path.join(os.path.dirname(__file__), "..", "secureeval.db")


def get_connection():
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    return conn


def get_user(username: str):
    conn = get_connection()
    # V1 FIX (Gemini): Parameterized query — input treated as data, not executable SQL
    query = "SELECT * FROM users WHERE username = ?"
    user = conn.execute(query, (username,)).fetchone()
    conn.close()
    return user


def verify_password(plain: str, stored_hash: str) -> bool:
    # V3 FIX (Gemini): passlib bcrypt verify — handles salt + constant-time comparison
    return pwd_context.verify(plain, stored_hash)


def create_token(username: str) -> str:
    # V2 FIX (Gemini): Uses strong env-var secret
    # V4 FIX (Gemini): Algorithm hardcoded to HS256 — header never trusted
    payload = {
        "sub": username,
        "exp": datetime.now(timezone.utc) + timedelta(minutes=ACCESS_TOKEN_EXPIRE_MINUTES)
    }
    return jwt.encode(payload, SECRET_KEY, algorithm=ALGORITHM)


def decode_token(token: str) -> dict:
    # V4 FIX (Gemini): Strictly enforce HS256 via algorithms parameter.
    # PyJWT rejects alg=none and all other unexpected algorithms automatically.
    # try/except ensures clean 401 instead of unhandled server crash.
    try:
        return jwt.decode(token, SECRET_KEY, algorithms=[ALGORITHM])
    except jwt.InvalidTokenError:
        raise HTTPException(status_code=401, detail="Invalid token")


def create_user(username: str, password: str):
    conn = get_connection()
    # V3 FIX (Gemini): Hash password with bcrypt before storing
    hashed_password = pwd_context.hash(password)
    # V1 FIX (Gemini): Parameterized INSERT — safe from SQL injection
    conn.execute(
        "INSERT INTO users (username, password) VALUES (?, ?)",
        (username, hashed_password),
    )
    conn.commit()
    conn.close()